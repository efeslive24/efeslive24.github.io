# Bu dosyayı kopyalayıp değerleri doldurun: cp .env.example .env
# Statik site olduğu için tüm değerler DERLEME zamanında okunur;
# değişiklik sonrası yeniden build gerekir.

# Gerçek alan adı (yayında zorunlu; sonunda / OLMAYACAK)
NEXT_PUBLIC_SITE_URL=https://www.siteadiniz.com

# Cloudflare Worker adresi (URL kısaltıcı + yönlendirme kontrolü için)
# Boş bırakılırsa bu iki araç "Kurulum bekleniyor" durumunu gösterir.
NEXT_PUBLIC_WORKER_URL=

# AdSense (isteğe bağlı — boşsa sayfaya hiçbir reklam kodu yüklenmez)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_AUTO=
NEXT_PUBLIC_ADSENSE_SLOT_HORIZONTAL=
